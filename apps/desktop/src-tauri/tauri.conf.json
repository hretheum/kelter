{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelter",
  "version": "0.1.0",
  "identifier": "dev.kelter.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Kelter",
        "width": 520,
        "height": 620,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "nsis": {}
    },
    "linux": {
      "deb": {}
    }
  }
}
