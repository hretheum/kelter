{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentkernel",
  "version": "0.1.0",
  "identifier": "dev.agentkernel.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "agentkernel",
        "width": 520,
        "height": 620,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
