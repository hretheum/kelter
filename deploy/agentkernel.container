# Quadlet unit: run the kernel under systemd with Podman.
# Install: copy to ~/.config/containers/systemd/agentkernel.container
# then: systemctl --user daemon-reload && systemctl --user start agentkernel
[Unit]
Description=agentkernel daemon (deterministic agent kernel)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/agentkernel:latest
ContainerName=agentkernel
PublishPort=7466:7466
Volume=%h/.config/agentkernel:/data/config:ro,Z
Volume=agentkernel-work:/data/work:Z
Exec=--config /data/config/config.toml
# Only needed when [policy] engine = "openrouter:<model>"; keep the key in
# an env file outside the repo, never in the unit itself.
EnvironmentFile=-%h/.config/agentkernel/env

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
