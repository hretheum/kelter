# Build artifacts
/target
apps/desktop/src-tauri/target
apps/desktop/src-tauri/gen
node_modules
extensions/*/.venv
examples/extensions/*/.venv
examples/extensions/*/memstore.json
examples/a2a-agent/.venv
examples/wasm-tools/*/target
/.bootstrap/

# Secrets & local env — never commit keys
.env
.env.*
*.key

# Local model files
*.gguf
models/

# Internal working briefs / prompt inputs — kept in prompts/, never committed
/prompts/
/prompt-*.md
/*zalozenia*.md

# OS noise
.DS_Store

# Raw local evidence logs are kept, but scratch dirs are not
/tmp/

# Phase 8.5: model config runtime state — the API key secret file (also
# covered by *.key above) and the persisted model overlay. NEVER commit these.
**/kelter-secret-*.key
**/model-override.toml

# Phase 11: TLS certs/keys — never commit. Demo certs are generated locally.
*.pem
*.crt

# Web-UI (Vite): build output is produced by CI / a local `pnpm build`
# (design/07 D-7) — the api crate embeds apps/web-ui/dist via RustEmbed.
apps/web-ui/dist/
apps/web-ui/tsconfig.tsbuildinfo
*.ign

# built desktop bundles (scripts/build-dmg.sh)
/dist/
